# Generate one owner value and use it for both variables.
CATALOGUE_OWNER_TOKEN=replace-with-one-random-value
EXPO_PUBLIC_CATALOGUE_OWNER_TOKEN=replace-with-the-same-random-value

# Local web and iOS Simulator default to this URL when it is omitted.
EXPO_PUBLIC_CATALOGUE_URL=http://127.0.0.1:4000

# For an iPhone on the same Wi-Fi, listen on the LAN and replace the example
# address with the Mac's Wi-Fi IP address.
# CATALOGUE_HOST=0.0.0.0
# EXPO_PUBLIC_CATALOGUE_URL=http://192.168.1.20:4000

# Backend only. Never prefix with EXPO_PUBLIC_.
# Uses direct Anthropic, not ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN.
# Leave empty to upload photos without automatic tagging.
ANTHROPIC_API_KEY=

# Backend only. Background removal runs on this machine's CPU with a model that
# ships with the service; it needs no key. Set to off to keep photos as shot.
# CATALOGUE_CUTOUTS=off
