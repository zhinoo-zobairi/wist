{
  "name": "wist",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "catalogue:build": "tsc -p catalogue-service/tsconfig.json",
    "catalogue:observe": "npm run catalogue:build && node catalogue-service/dist/observeProduct.js",
    "catalogue:probe:awin": "npm run catalogue:build && node catalogue-service/dist/probeAwin.js",
    "catalogue:probe:bobbies": "npm run catalogue:build && node catalogue-service/dist/probeBobbies.js",
    "catalogue:probe:sandro": "npm run catalogue:build && node catalogue-service/dist/probeSandro.js",
    "catalogue:start": "npm run catalogue:build && node --env-file-if-exists=.env.local catalogue-service/dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p catalogue-service/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.4.0",
    "@expo-google-fonts/inter": "^0.4.0",
    "@expo/metro-runtime": "~57.0.8",
    "@expo/vector-icons": "^15.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.9",
    "expo-font": "~57.0.1",
    "expo-notifications": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
}
